# Copiar como .env (el archivo .env nunca se sube a GitHub: está en .gitignore)

# Puerto local donde se abre el sitio con Docker (http://localhost:8080)
WEB_PORT=8080

# ---------------------------------------------------------------------
# Secretos de las Edge Functions de Supabase (solo referencia)
# En producción se configuran en Supabase → Edge Functions → Secrets.
# Aquí van SIN valor: nunca escribir una clave real en este archivo.
# El contenedor web no los usa.
# ---------------------------------------------------------------------

# Mercado Pago (crear-pago, mp-webhook)
# MP_ACCESS_TOKEN=          # token de acceso de la aplicación de Mercado Pago
# MP_WEBHOOK_SECRET=        # opcional: firma de las notificaciones del webhook

# Dirección pública de la tienda (crear-pago, enviar-correo)
# SITE_URL=                 # ej. https://aguabefine.cl (vuelta del pago y enlaces del correo)

# Correo con Resend (enviar-correo, mp-webhook)
# RESEND_API_KEY=           # clave de la API de Resend
# CORREO_REMITENTE=         # ej. Befine <pedidos@aguabefine.cl>
# AVISO_PEDIDOS_EMAIL=      # opcional: correo del dueño para el aviso de pedido pagado

# Reseñas de Google (resenas-google)
# GOOGLE_PLACES_KEY=        # clave de Google Places API (New)
# GOOGLE_PLACE_ID=          # identificador del local en Google Maps

# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los entrega Supabase
# automáticamente a las Edge Functions; no se configuran a mano.
